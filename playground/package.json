{
  "name": "dev-inspector-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable example apps for sql-dev-inspector and backend-dev-inspector, one per framework and data layer. Not published.",
  "license": "MIT",
  "workspaces": [
    "shared",
    "apps/*"
  ],
  "scripts": {
    "generate": "npm run generate -w nuxt3-prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:express-sqlite": "npm run dev -w express-sqlite",
    "dev:express-drizzle": "npm run dev -w express-drizzle",
    "dev:fastify-sqlite": "npm run dev -w fastify-sqlite",
    "dev:koa-sqlite": "npm run dev -w koa-sqlite",
    "dev:hono-sqlite": "npm run dev -w hono-sqlite",
    "dev:nuxt3-drizzle": "npm run dev -w nuxt3-drizzle",
    "dev:nuxt3-prisma": "npm run dev -w nuxt3-prisma",
    "dev:express-gateway": "npm run dev -w express-gateway"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.3",
    "light-my-request": "^6.8.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "sql-dev-inspector": "file:../packages/sql-dev-inspector"
  },
  "engines": {
    "node": ">=22"
  }
}
