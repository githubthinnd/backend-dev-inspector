{
  "name": "sql-dev-inspector",
  "type": "module",
  "version": "1.0.1",
  "description": "Dev-only SQL inspector for Node apps that talk to MySQL through mysql2 (Drizzle, Knex, Sequelize, TypeORM…): see which SQL each request ran, how transactions and subqueries nest, N+1 and slow queries. Terminal tree, web UI and a floating in-app launcher.",
  "author": "Nhu Duy Thin",
  "license": "MIT",
  "homepage": "https://github.com/githubthinnd/sql-dev-inspector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githubthinnd/sql-dev-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/githubthinnd/sql-dev-inspector/issues"
  },
  "keywords": [
    "mysql",
    "mysql2",
    "sql",
    "inspector",
    "debug",
    "devtools",
    "drizzle",
    "nuxt",
    "nitro",
    "express",
    "n+1",
    "transaction"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./nitro": {
      "types": "./dist/nitro-plugin.d.ts",
      "import": "./dist/nitro-plugin.js"
    },
    "./client": {
      "types": "./dist/client/widget.d.ts",
      "import": "./dist/client/widget.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.VI.md",
    "README.md",
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "peerDependencies": {
    "mysql2": ">=3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-orm": "^0.45.4",
    "happy-dom": "^20.8.4",
    "mysql2": "^3.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
